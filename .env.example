# Firebase web app config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=1:123:web:abc

# Realtime Database → Data (not in the web app snippet)
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Optional: Storage uploads
# VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Optional: push notifications
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# Set to "true" to talk to local emulators (pnpm emulators) in dev
VITE_USE_EMULATORS=false

# Where boards are stored: "local" (browser localStorage, default) or "firebase"
VITE_STORAGE_BACKEND=local
